#!/usr/bin/env bash
#
# phpantom_lsp resolver for Claude Code.
#
# This wrapper is used two ways, and forwards its arguments to a real
# phpantom_lsp binary in both:
#
#   * As the language server. Claude Code spawns it with no arguments and
#     proxies JSON-RPC over the child's stdin/stdout (the binary defaults to
#     stdio when given no subcommand).
#   * As a CLI. While the plugin is enabled this bin/ directory is on the Bash
#     tool's PATH, so `phpantom_lsp analyze`, `phpantom_lsp fix`, etc. resolve
#     here and run project-wide operations.
#
# It resolves the phpantom_lsp binary the user installed and `exec`s it, so both
# the LSP stream and CLI stdout pass straight through. It never downloads or
# installs anything: when no binary is found it prints install instructions to
# stderr and exits. stdout is left untouched for the caller.
#
# Resolution order:
#   1. $PHPANTOM_SERVER_PATH        — explicit override to a local binary
#   2. `phpantom_lsp` on $PATH      — a system-wide install (this wrapper's own
#                                     directory is skipped to avoid recursion)
#
# Environment variables:
#   PHPANTOM_SERVER_PATH   Absolute path to a phpantom_lsp binary to use as-is.

set -euo pipefail

BIN_NAME="phpantom_lsp"
SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

log() { printf '[phpantom] %s\n' "$*" >&2; }

die() {
  log "ERROR: $*"
  log "Install phpantom_lsp and make sure it is on your PATH, for example with:"
  log "  brew install phpantom-lsp"
  log "  cargo binstall phpantom_lsp"
  log "  cargo install phpantom_lsp --locked"
  log "or a prebuilt binary from https://github.com/PHPantom-dev/phpantom_lsp/releases."
  log "To use a binary that is not on your PATH, set PHPANTOM_SERVER_PATH to it."
  exit 1
}

# ── 1. Explicit override ──────────────────────────────────────────────────────
if [ -n "${PHPANTOM_SERVER_PATH:-}" ]; then
  [ -x "${PHPANTOM_SERVER_PATH}" ] || die "PHPANTOM_SERVER_PATH is not an executable file: ${PHPANTOM_SERVER_PATH}"
  exec "${PHPANTOM_SERVER_PATH}" "$@"
fi

# ── 2. A real phpantom_lsp on PATH (skipping this wrapper's own directory) ─────
find_on_path() {
  local dir found
  found=""
  local saved_ifs="${IFS}"
  IFS=:
  for dir in ${PATH}; do
    [ -z "${dir}" ] && continue
    # Resolve to an absolute path so the self-directory comparison is reliable.
    case "${dir}" in
      /*) : ;;
      *) dir="$(cd "${dir}" 2>/dev/null && pwd || true)" ;;
    esac
    [ -z "${dir}" ] && continue
    [ "${dir}" = "${SELF_DIR}" ] && continue
    if [ -x "${dir}/${BIN_NAME}" ]; then
      found="${dir}/${BIN_NAME}"
      break
    fi
  done
  IFS="${saved_ifs}"
  [ -n "${found}" ] && printf '%s\n' "${found}"
}

path_bin="$(find_on_path || true)"
if [ -n "${path_bin}" ]; then
  exec "${path_bin}" "$@"
fi

die "phpantom_lsp was not found on your PATH."
